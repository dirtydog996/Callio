# Callio 环境变量示例（复制为 .env 后按需修改）

# --- LLM ---
# 选择 LLM 提供方: ollama（默认）| openai | anthropic | gemini | openai_compatible
CALLIO_LLM_PROVIDER=ollama
CALLIO_LLM_MODEL=qwen2.5:7b

# Ollama 兼容端点（当 CALLIO_LLM_PROVIDER=ollama 时生效）
CALLIO_OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI（当 CALLIO_LLM_PROVIDER=openai 时）
# CALLIO_LLM_PROVIDER=openai
# CALLIO_LLM_MODEL=gpt-4o
# CALLIO_LLM_API_KEY=sk-...          # 也可直接设置 OPENAI_API_KEY

# Anthropic Claude（当 CALLIO_LLM_PROVIDER=anthropic 时）
# CALLIO_LLM_PROVIDER=anthropic
# CALLIO_LLM_MODEL=claude-opus-4-5
# CALLIO_LLM_API_KEY=ant-...         # 也可设置 ANTHROPIC_API_KEY

# Google Gemini（当 CALLIO_LLM_PROVIDER=gemini 时）
# CALLIO_LLM_PROVIDER=gemini
# CALLIO_LLM_MODEL=gemini-2.0-flash
# CALLIO_LLM_API_KEY=AIza...         # 也可设置 GEMINI_API_KEY 或 GOOGLE_API_KEY

# 任意 OpenAI 兼容 API（Groq / Together / Mistral / DeepSeek 等）
# CALLIO_LLM_PROVIDER=openai_compatible
# CALLIO_LLM_BASE_URL=https://api.groq.com/openai/v1
# CALLIO_LLM_MODEL=llama-3.3-70b-versatile
# CALLIO_LLM_API_KEY=gsk_...

# --- 语音识别 (STT) ---
# 后端选择: whisper（默认）| sensevoice（FunASR/SenseVoice，中文更准）
CALLIO_STT_BACKEND=whisper
CALLIO_WHISPER_MODEL=base
CALLIO_WHISPER_PRELOAD=1
# SenseVoice 模型 (仅 CALLIO_STT_BACKEND=sensevoice 时生效)
# CALLIO_FUNASR_MODEL=iic/SenseVoiceSmall

# --- 语音合成 (TTS) ---
# 后端选择: chatt（ChatTTS，默认）| say（macOS say）| edge（EdgeTTS）| cosyvoice | fish
CALLIO_TTS_BACKEND=chatt
CALLIO_TTS_PRELOAD=1
CALLIO_HF_ENDPOINT=https://hf-mirror.com
# EdgeTTS 语音（仅 CALLIO_TTS_BACKEND=edge 时生效）
# CALLIO_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# CosyVoice 服务器地址（仅 CALLIO_TTS_BACKEND=cosyvoice 时生效）
# CALLIO_COSYVOICE_URL=http://localhost:9880
# Fish Speech 服务器地址（仅 CALLIO_TTS_BACKEND=fish 时生效）
# CALLIO_FISH_SPEECH_URL=http://localhost:8080

# --- 会话结束通知（可选）---
# 在语音会话结束后推送摘要到指定 webhook（按需配置其一或多个）
# CALLIO_NOTIFY_WECHAT_WEBHOOK=
# CALLIO_NOTIFY_FEISHU_WEBHOOK=
# CALLIO_NOTIFY_DISCORD_WEBHOOK=
# CALLIO_NOTIFY_TELEGRAM_WEBHOOK=
# CALLIO_NOTIFY_TIMEOUT_SEC=8

# --- 编码 / 日常任务 Agent ---
# 后端选择: hermes | openclaw | goose | aider | claude（留空则自动探测）
# CALLIO_AGENT_BACKEND=hermes
# 自定义命令模板（{task} 会被替换为任务描述）
# CALLIO_AGENT_COMMAND=hermes run --task {task}

# --- 任务调度 ---
CALLIO_MAX_PARALLEL_TASKS=3
CALLIO_GLOBAL_MAX_PARALLEL=5
CALLIO_TASK_TIMEOUT_SEC=3600
CALLIO_EXECUTE_MAX_RETRIES=3
CALLIO_SUMMARIZE_DEBOUNCE_SEC=30
CALLIO_PROGRESS_INJECT=1
CALLIO_MEMORY_INJECT=1

# --- 工作区 ---
CALLIO_SANDBOX_ROOT=/Users/you/code/Callio

# --- HTTPS（手机测试）---
# CALLIO_SSL_CERT=certs/callio.pem
# CALLIO_SSL_KEY=certs/callio-key.pem
CALLIO_PORT=8000
