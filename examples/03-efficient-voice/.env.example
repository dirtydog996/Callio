# Efficient remote LLM + faster voice pipeline example
CALLIO_LLM_PROVIDER=openai_compatible
CALLIO_LLM_BASE_URL=https://api.deepseek.com/v1
CALLIO_LLM_MODEL=deepseek-chat
CALLIO_LLM_API_KEY=YOUR_DEEPSEEK_API_KEY

# ASR: SenseVoice is usually faster/more accurate for Chinese speech
CALLIO_STT_BACKEND=sensevoice
CALLIO_FUNASR_MODEL=iic/SenseVoiceSmall

# TTS: pick one backend below depending on your deployment
# Edge TTS (cloud service)
CALLIO_TTS_BACKEND=edge
CALLIO_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# CosyVoice server (self-hosted, lower local compute on Callio side)
# CALLIO_TTS_BACKEND=cosyvoice
# CALLIO_COSYVOICE_URL=http://localhost:9880

# Fish Speech server (self-hosted)
# CALLIO_TTS_BACKEND=fish
# CALLIO_FISH_SPEECH_URL=http://localhost:8080
